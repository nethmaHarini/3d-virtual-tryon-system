# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google OAuth Client ID (same as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Instructions:
# 1. Get the Client ID from Google Cloud Console
# 2. This should be the same value as GOOGLE_CLIENT_ID in backend/.env
# 3. Make sure it starts with VITE_ (Vite requirement)