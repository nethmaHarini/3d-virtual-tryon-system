# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Connection String
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Gmail Configuration for Email Functionality
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# JWT Secret Key (use a strong, random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Frontend URL (for CORS and OAuth redirects - use your Vercel URL for production)
FRONTEND_URL=http://localhost:5173

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server Port (automatically set by Render, optional for local dev)
PORT=3000

# Instructions:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create OAuth 2.0 credentials
# 3. Enable Gmail API for email functionality
# 4. Generate Gmail App Password (requires 2FA)
# 5. Replace all "your-*" values with actual credentials
# 6. For Render deployment, set DATABASE_URL to your Neon connection string